service/__pycache__/
__pycache__/

# Editor and IDE
.idea/
.vscode/
*.swp
*~

# Build output. node_modules and the packaged .deb are matched anywhere, not
# just under app/, so a build run from a subdirectory cannot slip one in.
node_modules/
app/dist/
app/dist-electron/
app/release/
app/logs/
*.deb

# Desktop clutter
.DS_Store
Thumbs.db

# Third-party kernel driver source, fetched by setup (has its own upstream)
Linuwu-Sense/

# Local working notes and reference checkouts of other drivers, kept on disk
# for comparison while debugging. Not part of the project, not published.
docs/

# Acer's own NitroSense installer and anything extracted from it. Kept locally
# for reverse engineering the WMI interface; theirs, not ours to redistribute.
Nitro Sense_Acer_*/
ns-extract/
*.resources

# Reference checkouts and a worktree of an earlier commit, used for comparing
# behaviour against this one while debugging. acer-turbo is facer, whose
# enable sequence the RGB patch is based on; it has its own upstream.
ref-dmm/
yesterday/
acer-turbo/

# Machine-specific firmware dumps: ACPI tables and EC register captures. Useful
# while investigating, meaningless on anyone else's laptop.
acpi/
*.dsl
*.dat
ec-dump-*.txt

# Raw screen captures. Only the curated set in screenshots/ is published.
app-screenshots/
Screenshot from *.png
