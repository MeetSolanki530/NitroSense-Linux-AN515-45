{
  "name": "damx-electron",
  "version": "0.1.0",
  "private": true,
  "description": "React/Electron frontend for the DAMX daemon (Div Acer Manager Max)",
  "type": "module",
  "scripts": {
    "probe": "node scripts/probe.ts",
    "build:electron": "node build-electron.mjs",
    "build:renderer": "vite build",
    "build": "npm run build:electron && npm run build:renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build:electron && VITE_DEV_SERVER_URL=http://localhost:5199 concurrently -k \"vite\" \"electron .\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-validate.ts && node scripts/test-telemetry.ts && node scripts/test-home.ts",
    "test:e2e": "node scripts/test-writes.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.3.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "main": "dist-electron/main.cjs"
}
