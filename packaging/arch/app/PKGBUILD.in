pkgname=nitrosense-linux
pkgver=0.2.0
pkgrel=1
pkgdesc='NitroSense fan, battery and keyboard controls for Linux'
arch=('x86_64')
url='https://github.com/MeetSolanki530/NitroSense-Linux-AN515-45'
license=('MIT' 'GPL-3.0-only')
depends=('python' 'polkit' 'gtk3' 'nss' 'alsa-lib' 'libxss' 'libxtst' 'libnotify' 'libsecret' 'xdg-utils')
makedepends=('nodejs>=22.12' 'npm')
optdepends=('linuwu-sense-an51545-dkms: hardware driver')
source=('nitrosense-source.tar.gz' 'nitrosense-launcher' 'nitrosense.desktop' 'nitrosense-daemon.service' 'nitrosense.sysusers')
# Generated by export-source.sh; never use SKIP for the release source archive.
sha256sums=(@CHECKSUMS@)
build() {
  cd "$srcdir/nitrosense/app"
  npm ci --ignore-scripts --cache "$srcdir/npm-cache"
  electron_config_cache="$srcdir/electron-cache" node node_modules/electron/install.js
  npm run build
}
check() {
  cd "$srcdir/nitrosense/app"
  npm run typecheck
  for suite in validate home format keyboard series; do
    node "scripts/test-$suite.ts"
  done
  cd ..
  python -m unittest discover -s tests
}
package() {
  cd "$srcdir/nitrosense"
  install -d "$pkgdir/opt/nitrosense/resources/app"
  cp -a app/node_modules/electron/dist/. "$pkgdir/opt/nitrosense/"
  cp -a app/dist app/dist-electron app/package.json "$pkgdir/opt/nitrosense/resources/app/"
  install -Dm755 "$srcdir/nitrosense-launcher" "$pkgdir/usr/bin/nitrosense"
  install -Dm644 "$srcdir/nitrosense.desktop" "$pkgdir/usr/share/applications/nitrosense.desktop"
  install -Dm644 app/build/icons/256x256.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/nitrosense.png"
  install -Dm644 "$srcdir/nitrosense-daemon.service" "$pkgdir/usr/lib/systemd/system/nitrosense-daemon.service"
  install -Dm644 "$srcdir/nitrosense.sysusers" "$pkgdir/usr/lib/sysusers.d/nitrosense.conf"
  install -d "$pkgdir/usr/lib/nitrosense"
  install -m644 service/*.py "$pkgdir/usr/lib/nitrosense/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
