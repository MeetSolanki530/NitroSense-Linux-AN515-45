+    struct acpi_buffer input = {(acpi_size)sizeof(param), &param};
+
+    return wmi_evaluate_method(WMID_GUID4, 0,
+                               ACER_WMID_SET_GAMING_RGB_KB_METHODID, &input, NULL);
+}
