+/* Wake the four-zone panel up. Without this it accepts every colour write and
+ * lights nothing, which is what made static look broken on AN515-45: writes
+ * succeeded at every layer, the colours landed correctly in the EC's
+ * KB1R..KB4B registers, and the keyboard stayed dark.
+ *
+ * Two calls, both taken from facer, which is the one driver known to light
+ * this model:
+ *
+ *   GetGamingSysInfo, apparently required before the panel will respond.
+ *   facer's comment says the same, for AN515-57.
+ *
+ *   SetGamingLED with 8 | (15 << 40). Byte 0 is ACER_GAMING_KBL_SET_ON, BIT(3)
+ *   in the mainline acer-wmi RFC, and bits 40 to 43 are the zone mask, its
+ *   ACER_GAMING_KBL_SET_ALL_ZONES. Both halves matter: sending the 15 in byte
+ *   1 rather than byte 5 is accepted and does nothing.
+ *
+ * Called from probe and again before every user-initiated write, because the
+ * panel can be handed back to the EC in between — clearing PSEE does that, and
+ * so does a power cycle. It is two WMI calls and idempotent.
+ *
+ * Return values are ignored on purpose: a model that does not implement these
+ * should still get its sysfs files.
+ */
+static void enable_four_zone_kb(void)
+{
+    u64 sysinfo = 0;
+
+    WMI_gaming_execute_u64(ACER_WMID_GET_GAMING_SYS_INFO_METHODID, 0, &sysinfo);
+    WMI_gaming_execute_u64(ACER_WMID_SET_GAMING_LED_METHODID,
+                           8ULL | (15ULL << 40), NULL);
+}
