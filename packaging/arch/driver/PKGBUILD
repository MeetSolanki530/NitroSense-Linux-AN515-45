prepare() {
  cd "$srcdir/driver"
  for patch in linuwu-sense-an515-45-rgb.patch linuwu-sense-misc-setting-status.patch linuwu-sense-backlight-timeout-decode.patch kernel-string-copy.patch; do
    git apply "$srcdir/$patch"
  done
}
package() {
  local dest="$pkgdir/usr/src/linuwu-sense-an51545-$pkgver"
  install -Dm644 "$srcdir/driver/src/linuwu_sense.c" "$dest/src/linuwu_sense.c"
  install -Dm644 "$srcdir/driver/Makefile" "$dest/Makefile"
  install -Dm644 "$srcdir/dkms.conf" "$dest/dkms.conf"
  install -Dm755 "$srcdir/build-module.sh" "$dest/build-module.sh"
  install -Dm644 "$srcdir/driver/LICENSE" "$dest/LICENSE"
  install -Dm755 "$srcdir/activate-driver.sh" "$pkgdir/usr/lib/nitrosense/activate-driver.sh"
  install -Dm755 "$srcdir/restore-stock-driver.sh" "$pkgdir/usr/lib/nitrosense/restore-stock-driver.sh"
  install -Dm644 "$srcdir/nitrosense-driver.service" "$pkgdir/usr/lib/systemd/system/nitrosense-driver.service"
}
# Service is shipped disabled; package installation does not load or blacklist drivers.
