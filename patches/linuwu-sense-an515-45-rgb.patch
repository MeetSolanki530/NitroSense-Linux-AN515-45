+/* The firmware expects exactly these four bytes. Passing the same fields as
+ * an 8-byte u64 (what this driver did) is accepted and silently ignored on
+ * AN515-45; four bytes works, which is what facer sends. */
+struct led_zone_set_param
+{
+    u8 zone;
+    u8 red;
+    u8 green;
+    u8 blue;
+} __packed;
+
+static acpi_status set_zone_color(u8 zone_mask, u8 red, u8 green, u8 blue)
+{
+    struct led_zone_set_param param = {
+        .zone = zone_mask, .red = red, .green = green, .blue = blue};
+    struct acpi_buffer input = {(acpi_size)sizeof(param), &param};
+
+    return wmi_evaluate_method(WMID_GUID4, 0,
+                               ACER_WMID_SET_GAMING_RGB_KB_METHODID, &input, NULL);
+}
